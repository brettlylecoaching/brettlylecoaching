{
  "name": "brettlylecoaching",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Brett Lyle Coaching: Astro site on Cloudflare Pages with a Formaloo-backed contact form.",
  "scripts": {
    "dev": "astro dev",
