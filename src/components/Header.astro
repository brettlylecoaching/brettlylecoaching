---
import Logo from './Logo.astro';
import { nav } from '../data/site';
const path = Astro.url.pathname;
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined);
---
<header>
  <div class="wrap bar">
    <Logo />
    <nav class="desktop" aria-label="Main">
      {nav.map((item) => <a class="plain" href={item.href} aria-current={current(item.href)}>{item.label}</a>)}
      <a class="btn solid" href="/contact">Book a consult</a>
    </nav>
    <details class="mobile">
      <summary aria-label="Menu"><span></span><span></span><span></span></summary>
      <nav aria-label="Main">
        {nav.map((item) => <a href={item.href} aria-current={current(item.href)}>{item.label}</a>)}
        <a class="btn solid" href="/contact">Book a free consult</a>
      </nav>
    </details>
  </div>
</header>
<style>
  header {
    position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--ground) 90%, transparent); backdrop-filter: blur(10px);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding-block: 14px; }
  .desktop { display: flex; gap: 26px; align-items: center; }
  .plain { font-weight: 600; font-size: 0.92rem; text-decoration: none; color: var(--muted); }
  .plain:hover, .plain[aria-current='page'] { color: var(--mint-ink); }
  .desktop .btn { padding: 0.55em 1.1em; white-space: nowrap; }

  .mobile { display: none; }
  summary { list-style: none; cursor: pointer; width: 44px; height: 44px; display: grid; place-content: center; gap: 5px; border-radius: 8px; }
  summary::-webkit-details-marker { display: none; }
  summary span { display: block; width: 22px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform 0.2s ease, opacity 0.2s ease; }
  .mobile[open] summary span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .mobile[open] summary span:nth-child(2) { opacity: 0; }
  .mobile[open] summary span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .mobile nav {
    position: absolute; left: 0; right: 0; top: 100%; display: grid; gap: 4px; padding: 12px 16px 20px;
    background: var(--ground); border-bottom: 1px solid var(--line); box-shadow: var(--shadow);
  }
  .mobile nav a:not(.btn) { padding: 12px 4px; font-weight: 700; font-size: 1.05rem; text-decoration: none; color: var(--ink); border-bottom: 1px solid var(--line); }
  .mobile nav a[aria-current='page'] { color: var(--mint-ink); }
  .mobile .btn { margin-top: 12px; text-align: center; }

  @media (max-width: 760px) {
    .desktop { display: none; }
    .mobile { display: block; }
  }
</style>
